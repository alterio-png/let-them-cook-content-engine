# REVIEW ONLY: NOT BUILT, NOT PUSHED, NOT APPROVED FOR DISTRIBUTION.
# G3B must supply a digest-pinned independently approved Linux x86_64 image
# containing Python3.12, reviewed locked Python dependencies, ffmpeg/ffprobe,
# libx264/AAC/libass, CA roots, and numeric UID/GID10001.
# No apt/pip/third-party binary download is authorized by this proposal.
# G0's existing --enable-gpl FFmpeg build is NOT a cleared product artifact.
ARG REVIEWED_RUNTIME_IMAGE
FROM ${REVIEWED_RUNTIME_IMAGE}
WORKDIR /app
COPY --chown=10001:10001 engine/ /app/engine/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
ENTRYPOINT ["python", "-m", "engine.cloud_worker"]
